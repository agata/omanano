#!/bin/sh
set -eu

OMANANO_NOTE_PATH=$1
OMANANO_NOTE_ID=$2
OMANANO_NOTE_TITLE=$3
OMANANO_BACKGROUND=$4
OMANANO_FOREGROUND=$5
OMANANO_ACCENT=$6

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
OMANANO_STORE_PATH=$script_dir/omanano-store
export OMANANO_NOTE_PATH OMANANO_NOTE_ID OMANANO_NOTE_TITLE OMANANO_BACKGROUND OMANANO_FOREGROUND OMANANO_ACCENT OMANANO_STORE_PATH
exec quickshell -d -p "$script_dir/../Detached.qml"
