#!/bin/sh
set -eu

OMALEAF_NOTE_PATH=$1
OMALEAF_NOTE_TITLE=$2
OMALEAF_BACKGROUND=$3
OMALEAF_FOREGROUND=$4
OMALEAF_ACCENT=$5
export OMALEAF_NOTE_PATH OMALEAF_NOTE_TITLE OMALEAF_BACKGROUND OMALEAF_FOREGROUND OMALEAF_ACCENT

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec quickshell -d -p "$script_dir/../Detached.qml"
