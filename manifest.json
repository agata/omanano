{
  "schemaVersion": 1,
  "id": "io.github.agata.omaleaf",
  "name": "OmaLeaf Notes",
  "version": "0.1.0",
  "author": "Agata",
  "description": "A calm, local-first Markdown notes library for Omarchy.",
  "kinds": [
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaLeaf Notes",
    "description": "Browse and edit local Markdown notes",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
